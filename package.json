{
  "name": "eos-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "自部署的多 agent 工作流平台，以 DeepSeek Harness 为执行内核",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "eos": "node --import tsx src/cli.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "e2e": "node --import tsx scripts/e2e.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331",
    "@base-ui/react": "1.9.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@xyflow/react": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
