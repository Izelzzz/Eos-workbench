#!/bin/sh
# 容器里运行 Eos 命令的入口：eos web、eos doctor……（镜像里装在 /usr/local/bin/eos）。
# 容器以 root 启动，这里降到平台用户 eos，只带着切换用户用的 SETUID、SETGID 两个能力：
# 检查命令要切换到 eos-check 运行，读不到平台和 dsh 进程环境里的主密钥和模型 key（docs/adr/006-docker-deployment.md）。
set -eu

if [ "$(id -u)" = 0 ]; then
  # setpriv 不改这几个变量；不改的话平台的 HOME 还是 /root。
  export HOME=/home/eos USER=eos LOGNAME=eos
  if ! setpriv --reuid=eos --regid=eos --init-groups --inh-caps=+setuid,+setgid --ambient-caps=+setuid,+setgid -- true 2>/dev/null; then
    echo "eos：切换不到平台用户 eos。容器要有 SETUID、SETGID 两个能力（compose.yaml 里的 cap_add），见 docs/deploy.md「用户和权限」" >&2
    exit 1
  fi
  exec setpriv --reuid=eos --regid=eos --init-groups --inh-caps=+setuid,+setgid --ambient-caps=+setuid,+setgid -- "$0" "$@"
fi

# 检查命令（eos-check）要能写 agent 改过的 worktree：worktree 目录属于共用组 eos-work 并带 setgid，
# 平台、agent 新建的文件都归这个组；umask 002 让它们组内可写。
umask 002
data="${EOS_HOME:-/data}"
# 在 || 左边调用时 set -e 不起作用，每一步自己判断失败。
# worktrees 目录本身是 2755：组内不可写。否则检查命令能把别的任务的 worktree 改名、换成指向平台目录的符号链接，
# 下一轮 agent 就能在平台的目录里写东西。每个任务的 worktree 里面才是组内可写的。
prepare() {
  mkdir -p "$data/worktrees" && chgrp eos-work "$data/worktrees" || return 1
  # 升级前（检查命令还和平台同一个用户时）建的 worktree 一次性改成这个组。
  # 有不属于 eos 的文件（例如用 root 进容器建的）时只改得了一部分：提示一次，照样记下做过，不在每次启动时重走一遍。
  if [ ! -e "$data/.worktrees-group" ]; then
    migrated=yes
    chgrp -hR eos-work "$data/worktrees" || migrated=no
    chmod -R g+w "$data/worktrees" || migrated=no
    find "$data/worktrees" -type d -exec chmod g+s {} + || migrated=no
    touch "$data/.worktrees-group" || return 1
    [ "$migrated" = yes ] || echo "eos：$data/worktrees 里有些文件改不成共用组 eos-work（不属于 eos），检查命令可能写不了它们" >&2
  fi
  # 放在迁移之后：上面的 chmod -R g+w 也会改到它。每次启动都设一遍，已有部署升级后也会改过来。
  chmod 2755 "$data/worktrees"
}
# 数据目录有问题时不在这里退出：让 eos doctor、启动检查说明原因。
prepare || echo "eos：没能把 $data/worktrees 设成共用组 eos-work，检查命令可能写不了 worktree" >&2

cd /app
exec node --import tsx src/cli.ts "$@"
