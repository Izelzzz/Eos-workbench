#!/bin/sh
# 容器里运行 Eos 命令的入口：eos web、eos doctor……（镜像里装在 /usr/local/bin/eos）。
# 容器以 root 启动，这里降到平台用户 eos，只带着三个能力（docs/adr/006-docker-deployment.md）：
# SETUID、SETGID 用来把检查命令切换到 eos-check、把 dsh 切换到 eos-agent，它们读不到平台进程环境里的主密钥；
# KILL 用来给它们的进程发信号（关掉 dsh、结束超时的检查命令）。
set -eu

if [ "$(id -u)" = 0 ]; then
  # setpriv 不改这几个变量；不改的话平台的 HOME 还是 /root。
  export HOME=/home/eos USER=eos LOGNAME=eos
  if ! setpriv --reuid=eos --regid=eos --init-groups --inh-caps=+setuid,+setgid,+kill --ambient-caps=+setuid,+setgid,+kill -- true 2>/dev/null; then
    echo "eos：切换不到平台用户 eos。容器要有 SETUID、SETGID、KILL 三个能力（compose.yaml 里的 cap_add），见 docs/deploy.md「用户和权限」" >&2
    exit 1
  fi
  exec setpriv --reuid=eos --regid=eos --init-groups --inh-caps=+setuid,+setgid,+kill --ambient-caps=+setuid,+setgid,+kill -- "$0" "$@"
fi

# 检查命令（eos-check）要能写 agent 改过的 worktree：worktree 目录属于共用组 eos-work 并带 setgid，
# 平台、agent 新建的文件都归这个组；umask 002 让它们组内可写。
umask 002
data="${EOS_HOME:-/data}"
# 在 || 左边调用时 set -e 不起作用，每一步自己判断失败。
# worktrees 目录本身是 2755：组内不可写。否则检查命令能把别的任务的 worktree 改名、换成指向平台目录的符号链接，
# 下一轮 agent 就能在平台的目录里写东西。每个任务的 worktree 里面才是组内可写的。
prepare() {
  mkdir -p "$data/worktrees" && chgrp eos-work "$data/worktrees" || return 1
  # 升级前（检查命令还和平台同一个用户时）建的 worktree 一次性改成这个组。
  # 有不属于 eos 的文件（例如用 root 进容器建的）时只改得了一部分：提示一次，照样记下做过，不在每次启动时重走一遍。
  if [ ! -e "$data/.worktrees-group" ]; then
    migrated=yes
    chgrp -hR eos-work "$data/worktrees" || migrated=no
    chmod -R g+w "$data/worktrees" || migrated=no
    find "$data/worktrees" -type d -exec chmod g+s {} + || migrated=no
    touch "$data/.worktrees-group" || return 1
    [ "$migrated" = yes ] || echo "eos：$data/worktrees 里有些文件改不成共用组 eos-work（不属于 eos），检查命令可能写不了它们" >&2
  fi
  # 放在迁移之后：上面的 chmod -R g+w 也会改到它。每次启动都设一遍，已有部署升级后也会改过来。
  chmod 2755 "$data/worktrees"
}
# dsh 的数据目录：dsh 以 eos-agent 运行，平台要往里写能力面（profiles），并以 eos-agent 的身份读会话日志（见 src/cli.ts）。
# 目录本身属于 eos、组 eos-dsh、2770：检查命令进不去。dsh 在里面建的目录是 0700，属于 eos-agent。
as_agent() {
  setpriv --reuid="$EOS_AGENT_USER" --regid="$EOS_AGENT_USER" --init-groups --inh-caps=-all --ambient-caps=-all -- "$@"
}
prepare_dsh() {
  dsh="$data/dsh"
  # 升级前的 dsh 以 eos 运行，留下的文件属于 eos、多是 0700、0600，eos-agent 用不了，也改不了属主（没有 CHOWN 能力）。
  # 以 eos-agent 复制一份（复制出来的属于它，权限照旧），旧的改名留着。只在启动平台时做：别的命令可能和正在运行的 dsh 同时跑。
  # .credentials.yaml 不复制：dsh 要求它只有属主能读，新的 dsh 会重新生成（里面是 dsh 自己的浏览器会话授权，没有模型 key）。
  if [ "${1:-}" = web ] && [ ! -e "$data/.dsh-agent" ] && [ -d "$dsh" ] && [ -n "$(ls -A "$dsh")" ]; then
    new="$data/dsh.agent-new"
    [ ! -e "$new" ] || as_agent rm -rf "$new" || return 1
    mkdir "$new" && chgrp eos-dsh "$new" && chmod 2770 "$new" || return 1
    # 让 eos-agent 读得到旧文件。.credentials.yaml 不改：组内可读时 dsh 拒绝启动，迁移失败、还用旧目录时也不能坏掉它。
    chgrp -R eos-dsh "$dsh" && find "$dsh" ! -name .credentials.yaml -exec chmod g+rX {} + || return 1
    # --no-overwrite-dir：目标目录本身属于 eos，eos-agent 改不了它的权限和时间。
    as_agent sh -c 'cd "$1" && tar --exclude=./.credentials.yaml -cf - . | tar -xpf - --no-overwrite-dir -C "$2"' sh "$dsh" "$new" || return 1
    mv "$dsh" "$data/dsh.before-agent" && mv "$new" "$dsh" || return 1
    echo "eos：dsh 的数据目录已复制成 $EOS_AGENT_USER 的，旧的留在 $data/dsh.before-agent（确认任务都正常后可以删掉）" >&2
  fi
  mkdir -p "$dsh" && chgrp eos-dsh "$dsh" && chmod 2770 "$dsh" && touch "$data/.dsh-agent"
}
# 数据目录有问题时不在这里退出：让 eos doctor、启动检查说明原因。
prepare || echo "eos：没能把 $data/worktrees 设成共用组 eos-work，检查命令可能写不了 worktree" >&2
if [ -n "${EOS_AGENT_USER:-}" ]; then
  prepare_dsh "${1:-}" || echo "eos：没能把 $data/dsh 准备成 $EOS_AGENT_USER 能用的，任务启动 dsh 时可能失败" >&2
fi

cd /app
exec node --import tsx src/cli.ts "$@"
